inputs = [
    "./deps/"
]

remove_type_prefix = "ufbx_"

remove_function_prefix = "ufbx_"

import_lib = "ufbx.lib"

package_name = "ufbx"

output_folder = "ufbx"

force_ada_case_types = true

type_overrides = {
    "Vec2" = "[2]Real"
    "Vec3" = "[3]Real"
    "Vec4" = "[4]Real"

    // Assumes UFBX_REAL_IS_FLOAT to be set below, so that `Real :: f32`
    "Quat" = "quaternion128"
}

clang_defines = {
    "UFBX_REAL_IS_FLOAT" = "1"
}

struct_field_overrides = {
    "Void_List.data" = "[^]"
    "Bool_List.data" = "[^]"
    "Uint32_List.data" = "[^]"
    "Real_List.data" = "[^]"
    "Vec2_List.data" = "[^]"
    "Vec3_List.data" = "[^]"
    "Vec4_List.data" = "[^]"
    "String_List.data" = "[^]"
    "Dom_Node_List.data" = "[^]"
    "Dom_Value_List.data" = "[^]"
    "Prop_List.data" = "[^]"
    "Element_List.data" = "[^]"
    "Unknown_List.data" = "[^]"
    "Node_List.data" = "[^]"
    "Mesh_List.data" = "[^]"
    "Light_List.data" = "[^]"
    "Camera_List.data" = "[^]"
    "Bone_List.data" = "[^]"
    "Empty_List.data" = "[^]"
    "Line_Curve_List.data" = "[^]"
    "Nurbs_Curve_List.data" = "[^]"
    "Nurbs_Surface_List.data" = "[^]"
    "Nurbs_Trim_Surface_List.data" = "[^]"
    "Nurbs_Trim_Boundry_List.data" = "[^]"
    "Procedural_Geometry_List.data" = "[^]"
    "Stereo_Camera_List.data" = "[^]"
    "Camera_Switcher_List.data" = "[^]"
    "Marker_List.data" = "[^]"
    "Lod_Group_List.data" = "[^]"
    "Skin_Deformer_List.data" = "[^]"
    "Skin_Cluster_List.data" = "[^]"
    "Blend_Deformer_List.data" = "[^]"
    "Blend_Channel_List.data" = "[^]"
    "Blend_Shape_List.data" = "[^]"
    "Cache_Deformer_List.data" = "[^]"
    "Cache_File_List.data" = "[^]"
    "Material_List.data" = "[^]"
    "Texture_List.data" = "[^]"
    "Video_List.data" = "[^]"
    "Shader_List.data" = "[^]"
    "Shader_Binding_List.data" = "[^]"
    "Anim_Stack_List.data" = "[^]"
    "Anim_Layer_List.data" = "[^]"
    "Anim_Value_List.data" = "[^]"
    "Anim_Curve_List.data" = "[^]"
    "Display_Layer_List.data" = "[^]"
    "Selection_Set_List.data" = "[^]"
    "Selection_Node_List.data" = "[^]"
    "Character_List.data" = "[^]"
    "Constraint_List.data" = "[^]"
    "Audio_Layer_List.data" = "[^]"
    "Audio_Clip_List.data" = "[^]"
    "Pose_List.data" = "[^]"
    "Metadata_Object_List.data" = "[^]"
    "Connection_List.data" = "[^]"
    "Uv_Set_List.data" = "[^]"
    "Color_Set_List.data" = "[^]"
    "Edge_List.data" = "[^]"
    "Face_List.data" = "[^]"
    "Mesh_Part_List.data" = "[^]"
    "Face_Group_List.data" = "[^]"
    "Subdivision_Weight_Range_List.data" = "[^]"
    "Subdivision_Weight_List.data" = "[^]"
    "Line_Segment_List.data" = "[^]"
    "Lod_Level_List.data" = "[^]"
